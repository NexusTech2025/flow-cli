        "Validates input prompt or user_query",
        "Hydrates DatasetSchemaContext (columns & types)",
        "Builds typed AgentQueryContext DTO"
      ],
      "status": "normal",
      "shapeType": "Process",
      "customData": {}
    },
    {
      "id": "node_context_providers",
      "label": "Context Providers",
      "description": "Hydrates table schema & operation catalog",
      "details": [
        "• DatasetSchemaProvider (Table column types & metadata)",
        "• OperationCatalogProvider (Available NastFlow operations)"
      ],
      "status": "normal",
      "shapeType": "Process",
      "customData": {
        "container": "OrchSupervisor",
        "containerTitle": "3. AgentOrchestrator (Central Supervisor)"
      }
    },
    {
      "id": "node_cycle_1",
      "label": "Cycle 1: Intent Classification",
      "description": "Orchestrator delegates intent classification",
      "details": [
        "Orchestrator invokes IntentClassifierSubAgent",
        "Gemini Flash (HTTP 200 in ~12s)",
        "Receives AgentResponse(Intent, 0.95)"
      ],
      "status": "ai",
      "shapeType": "Process",
      "customData": {
        "container": "OrchSupervisor",
        "containerTitle": "3. AgentOrchestrator (Central Supervisor)"
      }
    },
    {
      "id": "node_intent_decision",
      "label": "Orchestrator Intent Routing Decision",
      "description": "Orchestrator evaluates intent to determine next subagent",
      "details": [
        "Orchestrator inspects classified intent",
        "Branch A: conversational / explain_data",
        "Branch B: plan_pipeline"
      ],
      "status": "normal",
      "shapeType": "Decision",
      "customData": {
        "container": "OrchSupervisor",
        "containerTitle": "3. AgentOrchestrator (Central Supervisor)"
      }
    },
    {
      "id": "node_cycle_2a",
      "label": "Cycle 2a: Explainer",
      "description": "Orchestrator delegates conversational explanation",
      "details": [
        "Orchestrator invokes ExplainerSubAgent (~49s)",
        "Produces narrative insights & suggested followups",
        "Returns AgentResponse(Chat) to Orchestrator"
      ],
      "status": "ai",
      "shapeType": "Process",
      "customData": {
        "container": "OrchSupervisor",
        "containerTitle": "3. AgentOrchestrator (Central Supervisor)"
      }
    },
    {
      "id": "node_cycle_2b",
      "label": "Cycle 2b: Planner",
      "description": "Orchestrator delegates pipeline step generation",
      "details": [
        "FeasibilityChecker pre-flight validation",
        "PipelinePlanner synthesizes raw pipeline steps",
        "Returns AgentResponse(Plan) to Orchestrator"
      ],
      "status": "ai",
      "shapeType": "Process",
      "customData": {
        "container": "OrchSupervisor",
        "containerTitle": "3. AgentOrchestrator (Central Supervisor)"
      }
    },
    {
      "id": "node_cycle_2c",
      "label": "Cycle 2c: Parallel Check",
      "description": "Orchestrator coordinates parallel validation",
      "details": [
        "Orchestrator coordinates ParallelSubAgentCoordinator",
        "├─ SchemaValidatorSubAgent: validates step parameters",
        "└─ ExplainerSubAgent: generates summary",
        "Returns verified steps & errors to Orchestrator"
      ],
      "status": "ai",
      "shapeType": "Process",
      "customData": {
        "container": "OrchSupervisor",
        "containerTitle": "3. AgentOrchestrator (Central Supervisor)"
      }
    },
    {
      "id": "node_loop_guard",
      "label": "Self-Aware Loop & Convergence Guard",
      "description": "Supervisory iteration budget, stagnation & convergence check",
      "details": [
        "• Convergence: Check Schema & Feasibility errors",
        "• Budget: cycle_count < max_cycles (default 2)",
        "• Anti-Stagnation: plan_hash != previous_hash",
        "• Action: PASS (Clean) | REFINE (Fixable) | DIVERT (Stuck)"
      ],
      "status": "normal",
      "shapeType": "Decision",
      "customData": {
        "container": "OrchSupervisor",
        "containerTitle": "3. AgentOrchestrator (Central Supervisor)"
      }
    },
    {
      "id": "node_clarifier",
      "label": "ClarifierSubAgent (Divert / Fallback)",
      "description": "Self-healing fallback when stuck or ambiguous",
      "details": [
        "Invoked on cycle exhaustion or repeated validation failure",
        "Transforms raw schema errors into user-friendly clarification",
        "Returns AgentResponse(Clarification) with suggested options"
      ],
      "status": "ai",
      "shapeType": "Process",
      "customData": {
        "container": "OrchSupervisor",
        "containerTitle": "3. AgentOrchestrator (Central Supervisor)"
      }
    },
    {
      "id": "node_cycle_3_agg",
      "label": "Cycle 3: State Aggregation",
      "description": "Compiles turn results into AgentExecutionResult",
      "details": [
        "Orchestrator compiles turn results into AgentExecutionResult",
        "Validates feasibility & collects follow-up suggestions",
        "Returns AgentExecutionResult to AgentOrchestrationCommand"
      ],
      "status": "ai",
      "shapeType": "Process",
      "customData": {
        "container": "OrchSupervisor",
        "containerTitle": "3. AgentOrchestrator (Central Supervisor)"
      }
    },
    {
      "id": "node_cmd_synth",
      "label": "4. AgentOrchestrationCommand",
      "description": "Enriches Result Monad with: payload_type=\"agent\"",
      "details": [
        "Receives AgentExecutionResult from Orchestrator",
        "Enriches Result Monad with: payload_type=\"agent\"",
        "Returns SuccessResult(payload=AgentPayload)"
      ],
      "status": "success",
      "shapeType": "Process",
      "customData": {}
    },
    {
      "id": "node_dispatcher_resp",
      "label": "5. ActionDispatcher: Line 322",
      "description": "InternalSuccessResponse Validated",
      "details": [
        "Line 322: InternalSuccessResponse(payload=result.payload)",
        "Pydantic V2 discriminated union VALIDATED cleanly",
        "Zero union_tag_not_found errors"
      ],
      "status": "success",
      "shapeType": "Process",
      "customData": {}
    },
    {
      "id": "node_egress",
      "label": "6. WebSocket Response Delivery",
      "description": "Final response delivery to user UI",
      "details": [
        "SectionBuilder compiles Display Sections",
        "Consumer transmits verified JSON over WebSocket",
        "UI receives structured response & pipeline steps"
      ],
      "status": "success",
      "shapeType": "Terminator",
      "customData": {}
    }
